#!/bin/sh /etc/rc.common
# rustical — Omnical CalDAV/CardDAV server (RustiCal) on the router.
# Plain HTTP on 127.0.0.1:4000 only; TLS is terminated by dav-tls.
#
# Deployment: ~/router-dav/deploy.sh (re-run after every sysupgrade —
# /usr/sbin binaries are NOT preserved by sysupgrade).

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/rustical
CONFIG=/etc/rustical/config.toml

start_service() {
	[ -x "$PROG" ] || {
		logger -t rustical "ERROR: $PROG missing — re-run ~/router-dav/deploy.sh (after sysupgrade)"
		return 1
	}
	# NO "config must exist" check here. §9.3 (item 13): a factory flash has no
	# config.toml, and rustical serves a LAN-only setup wizard in exactly that
	# state. Refusing to start would make the wizard unreachable, so the one
	# thing that looks like a missing-config error is now the normal path.
	#
	# The pre-flight that still matters is the binary, because a sysupgrade wipes
	# /usr/sbin and the failure mode there is a service that respawns forever.
	# (The omnical package owns both files, so a flash restores them — §9.2.)
	mkdir -p /usr/local/share/rustical

	procd_open_instance
	# NB: --config-file is a top-level clap option — it MUST precede the subcommand
	# --config-file names a file that may not exist yet. That is deliberate:
	# setup mode is entered when the file is absent (§9.3), so passing the path
	# unconditionally is what lets one command line serve both the unconfigured
	# and the configured case. The wizard writes this exact path.
	#
	# OMNICAL_SETUP_BIND overrides the wizard's default listen address. It must
	# be a LAN address; setup mode refuses non-LAN peers per request regardless,
	# but binding wide is pointless when the device knows its own subnet.
	procd_set_param command "$PROG" --config-file "$CONFIG" serve
	procd_set_param env "OMNICAL_SETUP_BIND=${OMNICAL_SETUP_BIND:-192.168.1.1:8080}"
	procd_set_param respawn 3600 5 0
	# hard cap well under free RAM (raw rlimit bytes = 256 MiB)
	procd_set_param limits memory="268435456"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Config changes are picked up by a restart (procd sends SIGTERM first).
	restart
}

# §9.4 (item 14): a one-click diagnostics bundle, as a procd action rather than a
# subcommand the owner has to know about. The bundle is written to
# /tmp/support-bundle-*.txt, which is tmpfs and therefore disappears on the next
# reboot — a support bundle on persistent storage is a file full of hostnames and
# email addresses that nobody remembers to delete.
#
# Redaction is not this script's job: `rustical support-bundle` verifies that no
# secret survived and writes nothing if one did (§9.4's gate, row 50).
support_bundle() {
	OUT="/tmp/support-bundle-$(date +%Y%m%d-%H%M%S).txt"
	"$PROG" --config-file "$CONFIG" support-bundle --out-dir /tmp >/dev/null 2>&1
	# The command prints the path; find the file it actually wrote.
	ls -t /tmp/support-bundle-*.txt 2>/dev/null | head -1
}
