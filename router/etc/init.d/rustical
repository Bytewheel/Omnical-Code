#!/bin/sh /etc/rc.common
# rustical — Omnical CalDAV/CardDAV server (RustiCal) on the router.
# Plain HTTP on 127.0.0.1:4000 only; TLS is terminated by dav-tls.
#
# Deployment: ~/router-dav/deploy.sh (re-run after every sysupgrade —
# /usr/sbin binaries are NOT preserved by sysupgrade).

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/rustical
CONFIG=/etc/rustical/config.toml

start_service() {
	[ -x "$PROG" ] || {
		logger -t rustical "ERROR: $PROG missing — re-run ~/router-dav/deploy.sh (after sysupgrade)"
		return 1
	}
	[ -f "$CONFIG" ] || {
		logger -t rustical "ERROR: $CONFIG missing"
		return 1
	}
	mkdir -p /usr/local/share/rustical

	procd_open_instance
	# NB: --config-file is a top-level clap option — it MUST precede the subcommand
	procd_set_param command "$PROG" --config-file "$CONFIG" serve
	procd_set_param respawn 3600 5 0
	# hard cap well under free RAM (raw rlimit bytes = 256 MiB)
	procd_set_param limits memory="268435456"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Config changes are picked up by a restart (procd sends SIGTERM first).
	restart
}
