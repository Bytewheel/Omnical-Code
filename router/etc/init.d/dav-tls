#!/bin/sh /etc/rc.common
# dav-tls — rustls TLS tunnel in front of rustical.
# Terminates TLS on the WAN IP, port 8443 (Let's Encrypt cert for
# 0115d8cf.duckdns.org, deployed by acme.sh on the dev machine) and forwards
# plaintext to 127.0.0.1:4000.  ALPN is restricted to http/1.1; everything
# (including WebDAV-Push WebSockets) is passed through untouched.
#
# Per the 2026-09-04 port amendment: public URL is :8443 (the .truth site on
# 443 stays); the listen address is the WAN IP — NOT 0.0.0.0 — so this never
# collides with any current/future uhttpd binds (uhttpd stays on LAN :443).
#
# The service refuses to start without certs — enable it only in Phase 3
# after the first Let's Encrypt issuance.

START=96
STOP=15
USE_PROCD=1

PROG=/usr/sbin/dav-tls
CERT=/etc/rustical/tls/fullchain.pem
KEY=/etc/rustical/tls/key.pem
WAN_IF=eth0
WAN_IP=192.168.1.21        # DHCP from the upstream Deco — must stay pinned (the
                           # upstream port-forward targets this address too)
LISTEN="$WAN_IP:8443"
UPSTREAM="127.0.0.1:4000"

start_service() {
	[ -x "$PROG" ] || {
		logger -t dav-tls "ERROR: $PROG missing — re-run ~/router-dav/deploy.sh (after sysupgrade)"
		return 1
	}
	for f in "$CERT" "$KEY"; do
		[ -f "$f" ] || {
			logger -t dav-tls "ERROR: $f missing — not starting (issue the LE cert first, Phase 3)"
			return 1
		}
	done
	cur_ip="$(ip -4 -o addr show dev "$WAN_IF" 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')"
	[ "$cur_ip" = "$WAN_IP" ] || {
		logger -t dav-tls "ERROR: $WAN_IF has '$cur_ip', expected $WAN_IP (DHCP lease changed?) — fix the address (and the upstream port-forward), then restart"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" \
		--listen "$LISTEN" \
		--upstream "$UPSTREAM" \
		--cert "$CERT" \
		--key "$KEY" \
		--user nobody
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
