#!/bin/sh
# omnical.postinst — the stateful half of the appliance image.
#
# Everything the package file list covers is restored by opkg on install, on a
# fresh flash, without anyone running anything. This script covers only what a
# file list *cannot* express: edits to files this package does not own
# (/etc/sysupgrade.conf, /etc/crontabs/root) and a first-run seed that must not
# clobber a preserved config.
#
# Idempotent by construction, because the same script runs on a factory flash,
# on every `sysupgrade -k`, and again on every `opkg install --force-reinstall`
# that an operator might do to fix a broken unit. Every write is guarded by a
# presence test or an `|| append`.
#
# OMNICAL_ROOT is a test hook: set it to a directory and the script operates on
# that tree instead of /. scripts/firmware-gate.sh uses it to run this against a
# fake root twice and assert both the effects and the idempotence, which is the
# only way to test a postinst without flashing a unit.

set -e

R="${OMNICAL_ROOT:-}"
etc() { echo "$R/etc"; }

# ── 1. Persistence across future firmware updates ───────────────────────────
# /etc/rustical holds config.toml (SMTP credentials, the RSVP secret, LE
# certs); /usr/local/share/rustical holds the SQLite database. Without these
# two lines a `sysupgrade` leaves a working unit with no data and no config,
# which is the failure mode the runbook's step 2 warns about ("do NOT pass -n").
CONF_FILE="$(etc)/sysupgrade.conf"
[ -d "$(etc)" ] || mkdir -p "$(etc)"
touch "$CONF_FILE"
for line in /etc/rustical /usr/local/share/rustical; do
	grep -qxF "$line" "$CONF_FILE" || echo "$line" >> "$CONF_FILE"
done

# ── 2. No base config is seeded, and that is deliberate ────────────────────
# An earlier version of this script copied a sample `config.toml` in when none
# existed. It had to be removed, and the reason is worth keeping.
#
# With a seeded config, "the box has a config file" and "the box is configured"
# are different states, so the server had to guess which it was looking at — and
# `src/setup_mode.rs` had to grow a "tenancy on, but no tenants" branch to
# cover the gap. That branch then swallowed the error from a config that parses
# but cannot resolve any Host: a server with a bad `base_domain` sat there
# offering the setup wizard to anyone on the LAN, which is the administrator
# takeover §9.3 exists to prevent, performed by the device itself.
#
# So the two states are made identical instead. A factory unit has NO config,
# the server sees no config, and setup mode is unambiguous. The wizard writes
# the config the unit will actually run on, which is better than a generic
# default anyway: it is configured for the answers, not for a guess.
#
# Consequence for the init script: it must START with no config rather than
# refusing, or a factory unit never reaches the wizard. That is the `rustical`
# entry in `router/etc/init.d/rustical`.
CONFIGURED=no
[ -f "$(etc)/rustical/config.toml" ] && CONFIGURED=yes
mkdir -p "$(etc)/rustical" "$(etc)/rustical/tls"
# 0700: the directory holds the RSVP secret and any SMTP password once written.
chmod 700 "$(etc)/rustical" 2>/dev/null || true

# ── 3. The database directory must exist and be persistent ─────────────────
# /var is tmpfs on this platform, so /usr/local/share is the only durable place
# for the DB. Created here because a factory flash has no deploy.sh to do it.
mkdir -p "$R/usr/local/share/rustical"

# ── 4. The watchdog cron line ──────────────────────────────────────────────
# /etc/crontabs/root survives a sysupgrade only because
# /lib/upgrade/keep.d/busybox preserves it, which is a busybox implementation
# detail rather than a contract. Re-asserting the line on every install is
# cheap and is what makes a *reinstall* restore self-healing.
#     */5 * * * * /usr/bin/rustical-watchdog
CRON_DIR="$(etc)/crontabs"
CRON="$CRON_DIR/root"
if [ -d "$CRON_DIR" ]; then
	touch "$CRON"
	grep -qF '/usr/bin/rustical-watchdog' "$CRON" ||
		echo '*/5 * * * * /usr/bin/rustical-watchdog' >> "$CRON"
	/etc/init.d/cron enabled || /etc/init.d/cron enable 2>/dev/null || true
fi

# ── 5. Services ────────────────────────────────────────────────────────────
# Enabled unconditionally: a factory unit must come back serving after a flash
# with no operator present. Started only when configured, because a rustical
# process with no config is a process that crashes on boot and fills the log
# with a message the owner cannot see from a browser.
[ -x "$(etc)/init.d/dav-tls" ] && { /etc/init.d/dav-tls enable 2>/dev/null || true; }
[ -x "$(etc)/init.d/rustical" ] && { /etc/init.d/rustical enable 2>/dev/null || true; }

if [ "$CONFIGURED" = yes ]; then
	[ -n "$R" ] || {
		/etc/init.d/rustical restart 2>/dev/null || /etc/init.d/rustical start 2>/dev/null || true
		/etc/init.d/dav-tls restart 2>/dev/null || true
	}
else
	# No config, and that is a NORMAL state, not an error: rustical serves a
	# LAN-only setup portal (§9.3) until the wizard writes one. Starting it here
	# is the whole point — a factory unit has to reach the wizard somehow.
	[ -n "$R" ] || /etc/init.d/rustical start 2>/dev/null || true
	logger -t omnical "no config yet — starting first-boot setup mode (see §9.3)"
fi

if [ "$CONFIGURED" = yes ]; then
	logger -t omnical "omnical installed; existing config.toml preserved"
else
	logger -t omnical "omnical installed; no config.toml — first-boot setup mode (§9.3)"
fi
exit 0
